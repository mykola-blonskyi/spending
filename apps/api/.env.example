# Copy to apps/api/.env for local development. Never commit real values.
# Production values live only in Coolify's environment panel.

# development | test | production. Production enforces https origins and secure cookies.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://spending:spending@127.0.0.1:55440/spending

# Public origin the browser uses, without a trailing slash. Derived from it:
#   redirect URI             ${APP_ORIGIN}/api/v1/auth/callback
#   post-logout redirect URI ${APP_ORIGIN}/signin
APP_ORIGIN=http://localhost:5173

# OIDC provider (confidential client, client_secret_basic). For local work, run the fake provider:
#   pnpm --filter @spending/api fake-oidc --port 4400
# Plain-http issuers are accepted only with NODE_ENV=test, so set that when using the fake one.
OIDC_ISSUER=http://127.0.0.1:4400
OIDC_CLIENT_ID=spending-dev
OIDC_CLIENT_SECRET=spending-dev-secret

# Encrypts stored refresh and ID tokens (AES-256-GCM). Base64 of exactly 32 random bytes:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# Defaults to true. Browsers treat http://localhost as secure, so keep it true locally too.
# false switches the cookie name from __Host-spending_session to spending_session.
COOKIE_SECURE=true
