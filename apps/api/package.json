{
  "name": "@spending/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch --env-file .env",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi": "DATABASE_URL=postgres://openapi@localhost/openapi tsx scripts/write-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "fake-oidc": "tsx test/fake-oidc/main.ts",
    "db:check": "tsx scripts/check-migrations.ts && drizzle-kit check"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "drizzle-orm": "^0.45.4",
    "nestjs-zod": "^5.5.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.12",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
