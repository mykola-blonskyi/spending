  "components": {
    "schemas": {
      "HealthDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "additionalProperties": false
      },
      "AvatarUrl_Output": {
        "type": [
          "string",
          "null"
        ]
      },
      "SessionDto_Output": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "avatarUrl": {
                "$ref": "#/components/schemas/AvatarUrl_Output"
              },
              "locale": {
                "type": "string",
                "enum": [
                  "en",
                  "uk",
                  "ru",
                  "es"
                ]
              },
              "theme": {
                "type": "string",
                "enum": [
                  "light",
                  "dark",
                  "system"
                ]
              },
              "timezone": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "displayName",
              "avatarUrl",
              "locale",
              "theme",
              "timezone"
            ],
            "additionalProperties": false
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "EndSessionUrl_Output": {
        "type": [
          "string",
          "null"
        ]
      },
      "LogoutDto_Output": {
        "type": "object",
        "properties": {
          "endSessionUrl": {
            "$ref": "#/components/schemas/EndSessionUrl_Output"
          }
        },
        "required": [
          "endSessionUrl"
        ],
        "additionalProperties": false
      },
      "ProfileDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "$ref": "#/components/schemas/AvatarUrl_Output"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "uk",
              "ru",
              "es"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ]
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "avatarUrl",
          "locale",
          "theme",
          "timezone"
        ],
        "additionalProperties": false
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "uk",
              "ru",
              "es"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ]
          },
          "timezone": {
            "type": "string",
            "maxLength": 64
